# SMTP (server-only — set in Vercel Environment Variables for production)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=

# Enquiries inbox
CONTACT_TO_EMAIL=sales@grid.co.tt

# Optional: From address (defaults to SMTP_USER). Example for Gmail relay:
# SMTP_FROM=nexxgrid@gmail.com

# Optional: Google Search Console HTML tag verification (metadata only when set)
GOOGLE_SITE_VERIFICATION=
