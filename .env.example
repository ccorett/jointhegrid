# SMTP (server-only — never use NEXT_PUBLIC_ for credentials)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# From address (Gmail relay example)
SMTP_FROM=nexxgrid@gmail.com

# Enquiries inbox (comma-separated for multiple recipients)
CONTACT_TO_EMAIL=sales@grid.co.tt

# Optional: Google Search Console HTML tag verification (metadata only when set)
GOOGLE_SITE_VERIFICATION=
